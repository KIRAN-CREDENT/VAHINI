@model List<Vahini.Models.DataBatch>
@using Vahini.Models
@{
    ViewData["Title"] = "Work Queue";
    var pending    = Model.Where(b => b.Status == BatchStatus.Pending).ToList();
    var inProgress = Model.Where(b => b.Status == BatchStatus.InProgress).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="vahini-page-title mb-0">
            <span class="vahini-badge-dot bg-info"></span> Work Queue
        </h1>
        <p class="text-muted small mb-0">Claim a batch or continue active work</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="vahini-queue-counter">
            <span class="text-pending fw-bold">@pending.Count</span> available
        </span>
        <span class="vahini-queue-counter">
            <span class="text-inprogress fw-bold">@inProgress.Count</span> in progress
        </span>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show vahini-alert" role="alert">
        <strong>✓</strong> @success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show vahini-alert" role="alert">
        <strong>⚠</strong> @error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ── Pending / Available ─────────────────────────────────────────────────── *@
<div class="vahini-panel mb-4">
    <div class="vahini-panel-header">
        <span>Available to Claim</span>
        <span class="badge bg-pending text-dark">@pending.Count</span>
    </div>
    <div class="table-responsive">
        <table class="table vahini-table mb-0" id="pendingBatchesTable">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Priority</th>
                    <th>Created</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!pending.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            No batches available right now. Check back soon.
                        </td>
                    </tr>
                }
                @foreach (var batch in pending)
                {
                    <tr>
                        <td class="vahini-batch-title">@batch.Title</td>
                        <td><span class="vahini-priority-pill vahini-priority-@batch.Priority.ToString().ToLower()">@batch.Priority</span></td>
                        <td class="text-muted small">@batch.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        <td class="text-end">
                            <form asp-controller="Member" asp-action="Claim" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@batch.Id" />
                                <button type="submit" class="btn btn-sm btn-vahini-primary">
                                    Claim
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ── Active / In Progress ────────────────────────────────────────────────── *@
<div class="vahini-panel">
    <div class="vahini-panel-header">
        <span>My Active Work</span>
        <span class="badge bg-inprogress">@inProgress.Count</span>
    </div>
    <div class="table-responsive">
        <table class="table vahini-table mb-0" id="activeBatchesTable">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Priority</th>
                    <th>Data Source</th>
                    <th>Claimed</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!inProgress.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            No active batches. Claim one from the queue above.
                        </td>
                    </tr>
                }
                @foreach (var batch in inProgress)
                {
                    <tr>
                        <td class="vahini-batch-title">@batch.Title</td>
                        <td><span class="vahini-priority-pill vahini-priority-@batch.Priority.ToString().ToLower()">@batch.Priority</span></td>
                        <td>
                            <a href="@batch.DataUrl" target="_blank" rel="noopener"
                               class="vahini-data-link" title="Open source data">
                                Open Data ↗
                            </a>
                        </td>
                        <td class="text-muted small">@batch.UpdatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        <td class="text-end">
                            <form asp-controller="Member" asp-action="Submit" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@batch.Id" />
                                <button type="submit" class="btn btn-sm btn-vahini-review"
                                        onclick="return confirm('Submit this batch for admin review?')">
                                    Submit for Review
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
