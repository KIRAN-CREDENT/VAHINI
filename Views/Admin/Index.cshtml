@model Vahini.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin — Command Center";
}

@* ── Stat Cards ─────────────────────────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="vahini-page-title mb-0">
            <span class="vahini-badge-dot bg-success"></span> Command Center
        </h1>
        <p class="text-muted small mb-0">Real-time VAHINI pipeline overview</p>
    </div>
    <button class="btn btn-vahini-primary" data-bs-toggle="modal" data-bs-target="#createBatchModal">
        <i class="vahini-icon">＋</i> New Batch
    </button>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show vahini-alert" role="alert">
        <strong>✓</strong> @success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show vahini-alert" role="alert">
        <strong>⚠</strong> @error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="vahini-stat-card border-pending">
            <div class="vahini-stat-label">Pending</div>
            <div class="vahini-stat-value text-pending">@Model.TotalPending</div>
            <div class="vahini-stat-sub">awaiting assignment</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="vahini-stat-card border-inprogress">
            <div class="vahini-stat-label">In Progress</div>
            <div class="vahini-stat-value text-inprogress">@Model.TotalInProgress</div>
            <div class="vahini-stat-sub">actively being annotated</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="vahini-stat-card border-inreview">
            <div class="vahini-stat-label">In Review</div>
            <div class="vahini-stat-value text-inreview">@Model.TotalInReview</div>
            <div class="vahini-stat-sub">pending your decision</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="vahini-stat-card border-completed">
            <div class="vahini-stat-label">Completed</div>
            <div class="vahini-stat-value text-completed">@Model.TotalCompleted</div>
            <div class="vahini-stat-sub">of @Model.GrandTotal total</div>
        </div>
    </div>
</div>

<div class="vahini-panel mb-4 border-warning">
    <div class="vahini-panel-header text-warning">
        <span>Pending Member Approvals</span>
        @if (Model.PendingApprovals.Any())
        {
            <span class="badge bg-warning text-dark">@Model.PendingApprovals.Count</span>
        }
    </div>
    <div class="table-responsive">
        @if (Model.PendingApprovals.Any())
        {
            <table class="table vahini-table mb-0">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.PendingApprovals)
                    {
                        <tr>
                            <td>@user.Email</td>
                            <td class="text-end">
                                <form asp-controller="Admin" asp-action="ApproveUser" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="p-4 text-center text-muted">
                All team members are currently approved.
            </div>
        }
    </div>
</div>

@* ── Recent Batches Table ────────────────────────────────────────────────── *@
<div class="vahini-panel">
    <div class="vahini-panel-header">
        <span>Recent Batches</span>
        <span class="badge bg-secondary">@Model.RecentBatches.Count</span>
    </div>
    <div class="table-responsive">
        <table class="table vahini-table mb-0" id="recentBatchesTable">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Quality Score</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RecentBatches.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No batches yet. Create the first one above.
                        </td>
                    </tr>
                }
                @foreach (var batch in Model.RecentBatches)
                {
                    <tr>
                        <td class="vahini-batch-title">@batch.Title</td>
                        <td><span class="vahini-status-pill vahini-status-@batch.Status.ToString().ToLower()">@batch.Status</span></td>
                        <td><span class="vahini-priority-pill vahini-priority-@batch.Priority.ToString().ToLower()">@batch.Priority</span></td>
                        <td>
                            <div class="vahini-quality-bar">
                                <div class="vahini-quality-fill" style="width:@((batch.QualityScore * 100).ToString("F0"))%"></div>
                            </div>
                            <span class="vahini-quality-text">@batch.QualityScore.ToString("P0")</span>
                        </td>
                        <td class="text-muted small">@batch.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        <td class="text-end">
                            @if (batch.Status == Vahini.Models.BatchStatus.InReview)
                            {
                                <button class="btn btn-sm btn-vahini-review"
                                        data-bs-toggle="modal"
                                        data-bs-target="#reviewModal"
                                        data-batch-id="@batch.Id"
                                        data-batch-title="@batch.Title">
                                    Audit
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ── Create Batch Modal ──────────────────────────────────────────────────── *@
<div class="modal fade" id="createBatchModal" tabindex="-1" aria-labelledby="createBatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content vahini-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="createBatchModalLabel">Create New Batch</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label vahini-form-label" for="createTitle">Title</label>
                        <input id="createTitle" name="Title" class="form-control vahini-input" required placeholder="e.g. Medical Imaging Batch 42" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label vahini-form-label" for="createUrl">Data URL</label>
                        <input id="createUrl" name="DataUrl" type="url" class="form-control vahini-input" required placeholder="https://storage.vahini.ai/batches/..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label vahini-form-label" for="createPriority">Priority</label>
                        <select id="createPriority" name="Priority" class="form-select vahini-input">
                            <option value="Low">Low</option>
                            <option value="Medium" selected>Medium</option>
                            <option value="High">High</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-vahini-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-vahini-primary">Create Batch</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Review / Audit Modal ────────────────────────────────────────────────── *@
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content vahini-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="reviewModalLabel">Audit Batch</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="Review" method="post" id="reviewForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="reviewBatchId" />
                <input type="hidden" name="action" id="reviewAction" />
                <div class="modal-body">
                    <p class="mb-3">
                        Reviewing: <strong id="reviewBatchTitle" class="text-white"></strong>
                    </p>
                    <div class="mb-3">
                        <label class="form-label vahini-form-label" for="qualityScore">
                            Quality Score <span class="text-muted">(0.0 – 1.0)</span>
                        </label>
                        <input id="qualityScore" name="qualityScore" type="number"
                               min="0" max="1" step="0.01" value="0.85"
                               class="form-control vahini-input" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-vahini-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-vahini-reject" id="rejectBtn">Reject</button>
                    <button type="button" class="btn btn-vahini-approve" id="approveBtn">Approve</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Populate review modal with batch context
    document.getElementById('reviewModal').addEventListener('show.bs.modal', function (e) {
        const btn = e.relatedTarget;
        document.getElementById('reviewBatchId').value    = btn.dataset.batchId;
        document.getElementById('reviewBatchTitle').textContent = btn.dataset.batchTitle;
    });
    document.getElementById('approveBtn').addEventListener('click', function () {
        document.getElementById('reviewAction').value = 'Approve';
        document.getElementById('reviewForm').submit();
    });
    document.getElementById('rejectBtn').addEventListener('click', function () {
        document.getElementById('reviewAction').value = 'Reject';
        document.getElementById('reviewForm').submit();
    });
</script>
}
